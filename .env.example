# Copier ce fichier vers .env (qui n'est pas versionné) et renseigner la clé.
# Clé API : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optionnels
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
# Modèles essayés si le principal reste saturé (503), séparés par des virgules ; vide = aucun
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-flash-latest
